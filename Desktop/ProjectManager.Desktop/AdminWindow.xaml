<Window x:Class="ProjectManager.Desktop.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Администрирование — учётные записи"
        Height="640" Width="980" MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Администрирование" Style="{StaticResource H1}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Muted}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Добавить" Style="{StaticResource PrimaryButton}" Click="Add_Click" Margin="0,0,8,0" />
                <Button Content="Изменить" Style="{StaticResource GhostButton}" Click="Edit_Click" Margin="0,0,8,0" />
                <Button Content="Сбросить пароль" Style="{StaticResource GhostButton}" Click="ResetPassword_Click" Margin="0,0,8,0" />
                <Button x:Name="BlockButton" Content="Блокировать" Style="{StaticResource GhostButton}" Click="Block_Click" Margin="0,0,8,0" />
                <Button Content="Удалить" Style="{StaticResource DangerButton}" Click="Delete_Click" Margin="0,0,8,0" />
                <Button Content="Обновить" Style="{StaticResource GhostButton}" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <DataGrid x:Name="UsersGrid" Style="{StaticResource Grid}"
                      SelectionChanged="UsersGrid_SelectionChanged"
                      MouseDoubleClick="UsersGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ЛОГИН" Binding="{Binding Login}" Width="140" />
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="РОЛЬ" Binding="{Binding RoleText}" Width="130" />
                    <DataGridTextColumn Header="СТАТУС" Binding="{Binding StatusText}" Width="120" />
                    <DataGridTextColumn Header="СОЗДАН" Binding="{Binding CreatedAtText}" Width="100" />
                    <DataGridTextColumn Header="ПРОЕКТОВ" Binding="{Binding ProjectsCount}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="InfoText" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <Button Content="Закрыть" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                    Click="Close_Click" MinWidth="110" />
        </Grid>
    </Grid>
</Window>
