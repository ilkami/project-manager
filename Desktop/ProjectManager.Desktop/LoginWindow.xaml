<Window x:Class="ProjectManager.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — Project Manager"
        Height="560" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Border Style="{StaticResource Card}" Width="360" VerticalAlignment="Center" Padding="28,26">
            <StackPanel>
                <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Left" Margin="0,0,0,16">
                    <TextBlock Text="PM" Foreground="White" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="Project Manager" Style="{StaticResource H1}" />
                <TextBlock Text="Учёт личных проектов программиста"
                           Style="{StaticResource Muted}" Margin="0,4,0,22" />

                <TextBlock Text="Логин" Style="{StaticResource Caption}" />
                <TextBox x:Name="LoginBox" Style="{StaticResource Input}" Margin="0,0,0,14" />

                <TextBlock Text="Пароль" Style="{StaticResource Caption}" />
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPassword}" Margin="0,0,0,16" />

                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" />

                <Button Content="Войти" Style="{StaticResource PrimaryButton}"
                        Height="38" Click="SignIn_Click" IsDefault="True" />

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Демо: admin" Style="{StaticResource SmallButton}"
                            Margin="0,0,4,0" Click="DemoAdmin_Click" />
                    <Button Grid.Column="1" Content="Демо: ivanov" Style="{StaticResource SmallButton}"
                            Margin="4,0,0,0" Click="DemoUser_Click" />
                </Grid>

                <TextBlock Text="admin / admin123 — администратор, ivanov / user123 — пользователь"
                           Style="{StaticResource Muted}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="11" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
