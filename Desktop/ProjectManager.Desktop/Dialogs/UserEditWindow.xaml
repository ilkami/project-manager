<Window x:Class="ProjectManager.Desktop.Dialogs.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учётная запись"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">

    <Border Style="{StaticResource Card}" Margin="16" Padding="22,18">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Text="Новая учётная запись" Style="{StaticResource H1}" FontSize="18" />

            <TextBlock Text="Логин *" Style="{StaticResource Caption}" Margin="0,16,0,4" />
            <TextBox x:Name="LoginBox" Style="{StaticResource Input}" />

            <TextBlock Text="ФИО" Style="{StaticResource Caption}" Margin="0,12,0,4" />
            <TextBox x:Name="FullNameBox" Style="{StaticResource Input}" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Роль" Style="{StaticResource Caption}" />
                    <ComboBox x:Name="RoleBox" Style="{StaticResource Combo}" />
                </StackPanel>
                <CheckBox x:Name="ActiveBox" Grid.Column="2" Content="Учётная запись активна"
                          Style="{StaticResource Check}" VerticalAlignment="Bottom" Margin="0,0,0,10" />
            </Grid>

            <StackPanel x:Name="PasswordPanel">
                <TextBlock Text="Пароль * (минимум 5 символов)" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPassword}" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="Отмена" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
