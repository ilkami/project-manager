<Window x:Class="ProjectManager.Desktop.Dialogs.ProjectEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проект"
        Width="580" SizeToContent="Height" MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">

    <Border Style="{StaticResource Card}" Margin="16" Padding="22,18">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Text="Новый проект" Style="{StaticResource H1}" FontSize="18" />
            <TextBlock Text="Поля со звёздочкой обязательны" Style="{StaticResource Muted}" Margin="0,4,0,0" />

            <TextBlock Text="Название *" Style="{StaticResource Caption}" Margin="0,16,0,4" />
            <TextBox x:Name="TitleBox" Style="{StaticResource Input}" />

            <TextBlock Text="Описание" Style="{StaticResource Caption}" Margin="0,12,0,4" />
            <TextBox x:Name="DescriptionBox" Style="{StaticResource InputMultiline}" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Дата начала (дд.мм.гггг)" Style="{StaticResource Caption}" />
                    <TextBox x:Name="StartDateBox" Style="{StaticResource Input}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Срок сдачи (дд.мм.гггг)" Style="{StaticResource Caption}" />
                    <TextBox x:Name="DeadlineBox" Style="{StaticResource Input}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Статус" Style="{StaticResource Caption}" />
                    <ComboBox x:Name="StatusBox" Style="{StaticResource Combo}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ссылка на репозиторий" Style="{StaticResource Caption}" />
                    <TextBox x:Name="RepoBox" Style="{StaticResource Input}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Технологии (через запятую)" Style="{StaticResource Caption}" Margin="0,12,0,4" />
            <TextBox x:Name="TechBox" Style="{StaticResource Input}" />
            <TextBlock Text="Например: C#, .NET 8, WPF, Python, Flask — новые названия попадут в справочник"
                       Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="Отмена" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
